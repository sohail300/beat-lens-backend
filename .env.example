# Database (PostgreSQL). For Neon, use the pooled connection string.
DB_URL=

# Spotify API (only needed by `python -m app.cli add <spotify url>`)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Storage (optional; default to songs/, recordings/ and tmp/ inside the backend folder)
SONGS_DIR=
RECORDINGS_DIR=
TMP_DIR=
# Keep each added song's WAV in SONGS_DIR (used by `cli reindex` and `cli edit`)
KEEP_AUDIO=true
# Files in TMP_DIR older than this (seconds) are deleted as leftovers from crashed requests
TMP_MAX_AGE_SECONDS=3600

# Audio processing
FINGERPRINT_STEREO=false
MAX_UPLOAD_MB=20

# Recognition (defaults are calibrated on real music; see README "How matching decides")
MAX_CLIP_SECONDS=20
MIN_MATCH_SCORE=10
MIN_MATCH_RATIO=2.5
MAX_SAMPLE_FINGERPRINTS=20000

# Abuse protection: recognition requests per client IP per minute, per server worker (0 disables)
RATE_LIMIT_PER_MINUTE=30
# Samples fingerprinted at once per worker (0 = one per CPU core)
RECOGNITION_CONCURRENCY=0

# Server
ENV=development
PORT=5000
# INFO in production, DEBUG otherwise, unless set
LOG_LEVEL=
# Comma-separated list of origins allowed to call the API (your frontend's URL)
CORS_ORIGINS=http://localhost:3000
# Optional: report errors to Sentry
SENTRY_DSN=

# Docker only (see start.sh)
WEB_CONCURRENCY=2
RUN_MIGRATIONS=false
